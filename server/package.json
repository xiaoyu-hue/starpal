  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node ../scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "tsx --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=91 --test-coverage-branches=72 --test-coverage-functions=87 \"tests/**/*.test.ts\""
  },
  "dependencies": {
