    "@dicebear/glass": "9.4.2",
    "@dicebear/icons": "9.4.2",
    "@dicebear/identicon": "9.4.2",
    "@dicebear/initials": "9.4.3",
    "@dicebear/lorelei": "9.4.2",
    "@dicebear/lorelei-neutral": "9.4.2",
    "@dicebear/micah": "9.4.2",
    "@dicebear/miniavs": "9.4.2",
