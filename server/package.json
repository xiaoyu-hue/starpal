{
  "name": "@starpal/server",
  "private": true,
  "version": "1.0.3",
  "license": "AGPL-3.0-or-later",
  "author": "xiaoyu-hue <https://github.com/xiaoyu-hue>",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node ../scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "hash-wasm": "^4.13.0",
    "multer": "^2.5.0",
    "pg": "8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
