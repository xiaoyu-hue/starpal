# 运行环境
NODE_ENV=development
PORT=3000

# 数据库
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# 会话
SESSION_SECRET=<由部署方生成的高熵随机值>
SESSION_TTL_HOURS=168

# 注册与防刷（邀请码已改为「一人一码」，由管理员在管理界面生成，不再用环境变量统一码）
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX=20
LOGIN_FAIL_MAX=5
SECURITY_EVENT_RETENTION_DAYS=30

# 内容与请求体上限（图片以二进制存于数据库，无本地文件目录）
MAX_UPLOAD_BYTES=3145728
MAX_BODY_BYTES=4194304
PUBLIC_DIR=./server/public

# 初始管理员（仅初始化脚本读取，不常驻配置）
# 安全提示：不要把密码直接写在命令行里（会留在 shell 历史与进程列表）。
#   建议把下面三项写入未被 Git 跟踪的 .env.local，
#   再用 `node --env-file=.env.local scripts/init-admin.mjs` 执行。
ADMIN_USERNAME=<由部署方设置>
ADMIN_PASSWORD=<由部署方设置>
ADMIN_DISPLAY_NAME=<可选，留空则使用用户名>
